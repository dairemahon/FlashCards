#General Rule:
#    anything auto-generated by the system should be ignored, 
#   as well as any sensitive information that should not be 
#   shared publicly.



# Ignores Python cache files and compiled bytecode
**/__pycache__
# Ignores Python cache files and compiled bytecode
**/*.pyc

# Don't want people to see db passwords, secretkeys
.env

# This contains real user data. We are using postgres anyway
*.sqlite3

# This is git history, large and unnecessary for the project
.git

# Dockerfile install packages fresh inside the container, 
# copying them would be redundant and waste space
frontend/node_modules
# This is any previously built react files on your machine
# Dockerfile runs npm run build inside the container, 
# so copying them would be redundant and waste space
frontend/dist

# Django static files are collected into this folder, which is served by nginx.
# Dockerfile runs npm run build inside the container, 
# so copying them would be redundant and waste space
staticfiles